# ポートは本職の開発と競合しないよう 47300〜47302 に固定している（ADR 0015）
#   web 47300 / api 47301 / mock-site 47302。すべて 127.0.0.1 でのみ待ち受ける

# API
API_PORT=47301
# 設定すると API に Authorization: Bearer <token> が必要になる（web 側にも同じ値を設定する）
API_TOKEN=

# web から API への接続先
API_URL=http://127.0.0.1:47301

# ログイン（ADR 0016）
# https で公開するときは true にする（http://127.0.0.1 で使うなら false のまま。true だと Cookie が保存されない）
SESSION_COOKIE_SECURE=false
# 招待リンクや通知から開く URL のもと。空なら web はアクセスしてきたホストを、API は http://127.0.0.1:47300 を使う
APP_URL=

# ブラウザ通知（Web Push）の鍵（ADR 0017）。make setup / make web-push-keys で生成する。空ならブラウザ通知は使わない
# 鍵を変えると、登録済みの端末には届かなくなる（設定画面でもう一度オンにする）
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# プッシュサービスに伝える連絡先（mailto: か https:）
WEB_PUSH_SUBJECT=

# SQLite（リポジトリ直下の data/ は .gitignore 済み）
DATABASE_URL=file:./data/zero-second.sqlite

# ログイン情報を暗号化する鍵（32 バイトを base64 で）。生成例: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# 検証用のモックサイト（apps/mock-site）
MOCK_SITE_PORT=47302
# striker がモックサイトへ送る先（Docker では compose が http://mock-site:47302 に上書きする）
MOCK_SITE_URL=http://127.0.0.1:47302
# 各リクエストに足す応答の遅れ（ミリ秒、0〜2 倍でばらつく）
MOCK_SITE_LATENCY_MS=30
# Date ヘッダーに足すずれ（ミリ秒）。時刻合わせの確認用
MOCK_SITE_CLOCK_SKEW_MS=0

# striker の予約確認の間隔と、販売開始のどれだけ前に準備を始めるか（ミリ秒）
STRIKER_POLL_INTERVAL_MS=1000
STRIKER_LEAD_MS=120000

# striker のログレベル
RUST_LOG=striker=info
