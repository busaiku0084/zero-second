# API
API_PORT=8787
# 設定すると API に Authorization: Bearer <token> が必要になる（web 側にも同じ値を設定する）
API_TOKEN=

# web から API への接続先
API_URL=http://127.0.0.1:8787

# SQLite（リポジトリ直下の data/ は .gitignore 済み）
DATABASE_URL=file:./data/zero-second.sqlite

# ログイン情報を暗号化する鍵（32 バイトを base64 で）。生成例: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# 検証用のモックサイト（apps/mock-site）
MOCK_SITE_PORT=8788
# 各リクエストに足す応答の遅れ（ミリ秒、0〜2 倍でばらつく）
MOCK_SITE_LATENCY_MS=30
# Date ヘッダーに足すずれ（ミリ秒）。時刻合わせの確認用
MOCK_SITE_CLOCK_SKEW_MS=0

# striker の予約確認の間隔と、販売開始のどれだけ前に準備を始めるか（ミリ秒）
STRIKER_POLL_INTERVAL_MS=1000
STRIKER_LEAD_MS=120000

# striker のログレベル
RUST_LOG=striker=info
